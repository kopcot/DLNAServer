@* Interactive, unlike most read-only pages here, because the figures refresh themselves. That costs a
   SignalR circuit - and with it a DI scope holding a DbContext and a pooled SQLite connection - on the
   page most likely to be left open in a tab. Taken deliberately: see docs/history.md section 6q. *@

@page "/admin"
@rendermode InteractiveServer
@inherits AdminPageBase
@inject IServedFileCache Cache
@inject IMediaFileRepository Files
@inject IMediaDirectoryRepository Directories
@inject IApiBlocker Blocker
@inject IMediaCapabilities Capabilities
@inject IMediaFormatter Fmt
@inject LibraryCountsCache CountsCache
@inject ILibraryChangeSignal Changes
@inject ITemporaryFolderVisibility Visibility
@inject TimeProvider Time

<PageHeader Title="Dashboard">
    What the server is holding, and how much of this machine it is using.
</PageHeader>

@if (_blocked is not null)
{
    <Notice IsBad="true">
        Televisions are paused until @Fmt.Clock(_blocked). These pages keep working.
    </Notice>
}

@* Shown only when the answer is a definite no. Availability resolves on first use, so null means nothing
   has needed ffmpeg yet and a fresh start must not raise a false alarm. *@
@if (Capabilities.IsVideoProcessingAvailable == false)
{
    <Notice IsBad="true">
        <strong>Video support is not installed</strong>, so lengths, picture sizes, sound tracks and
        subtitles are not being read, and no previews are being made for videos. The search page has no
        languages to choose from either. Browsing and playing your media still work normally.
        To fix it, put the video helper programs in the <code>ffmpeg</code> folder next to the server,
        then use <em>Rebuild all file details</em> on the Maintenance page.
    </Notice>
}

<Panel Heading="Server">
    <StatGrid>
        <StatTile Label="Running for" Source="Process start time (elapsed)">@Fmt.Elapsed(_uptime)</StatTile>
        <StatTile Label="Started" Source="Process start time (UTC)">@Fmt.Day(_startedUtc) @Fmt.Clock(_startedUtc)</StatTile>
    </StatGrid>
    <p class="muted">
        Counted from when the server last started. Restarting it, changing a setting marked as needing a
        restart, or <em>Recreate database</em> all set this back to nothing - so a figure much smaller
        than you expect means something restarted the server.
    </p>
</Panel>

<Panel Heading="Memory">
    <StatGrid>
        <StatTile Label="Total in use" Source="Working Set (MB)" IsOverTarget="_workingSetBytes > WorkingSetTargetBytes">@Fmt.Megabytes(_workingSetBytes)</StatTile>
        <StatTile Label="Used by the server itself" Source="GC Total Memory (MB)">@Fmt.Megabytes(_managedBytes)</StatTile>
        <StatTile Label="Used by large items" Source="GC Large Object Heap (MB)">@Fmt.Megabytes(_lohBytes)</StatTile>
        <StatTile Label="Tidy-ups so far" Source="GC Collections Gen0/Gen1/Gen2">@_gen0 / @_gen1 / @_gen2</StatTile>
    </StatGrid>
    <p class="muted">
        <em>Total in use</em> is the figure that matters on a small machine; the target is
        @WorkingSetTargetMb MB. <em>Used by large items</em> is mostly the recently served files below.
    </p>
</Panel>

<Panel Heading="Recently served files">
    <StatGrid>
        @* Formatted through IMediaFormatter, which is also what the File cache page uses. These two tiles
           once divided with two long operands and truncated, so the two pages reported different numbers
           for the same bytes. *@
        <StatTile Label="In use" Source="ServedFileCacheReport.BytesHeld (MB)">@Fmt.Megabytes(_report.BytesHeld)</StatTile>
        <StatTile Label="Limit" Source="config.json Dlna.FileCache.MaxTotalSizeInMegabytes (MB)">@Fmt.Megabytes(_report.BudgetInBytes)</StatTile>
        <StatTile Label="Files kept" Source="ServedFileCacheReport.EntryCount">@_report.EntryCount</StatTile>
        @* Not "Served from memory" any more: previews read out of the database count towards this too,
           and the drives are what the figure is really about. *@
        <StatTile Label="Served without the disc" Source="ServedFileCacheReport (Hits + DatabaseHits) / (Hits + Misses) (%)">@HitRate()</StatTile>
    </StatGrid>
</Panel>

<Panel Heading="Library">
    <StatGrid>
        <StatTile Label="Files" Source="database Files row count, folders the library hides left out">@_counts.Total</StatTile>
        <StatTile Label="Folders" Source="database Directories row count">@_directoryCount</StatTile>
    </StatGrid>
    @* The totals on the first row, what Files is made of on the second. *@
    <StatGrid>
        <StatTile Label="Video" Source="database Files grouped by MIME, the kinds that map to video">@_counts.Video</StatTile>
        <StatTile Label="Music" Source="database Files grouped by MIME, the kinds that map to audio">@_counts.Audio</StatTile>
        <StatTile Label="Photos" Source="database Files grouped by MIME, the kinds that map to image">@_counts.Image</StatTile>
        @* Only when there is something in it, so the four kinds visibly add up to the total when there
           is not. A file lands here when its type maps to no kind at all. *@
        @if (_counts.Other > 0)
        {
            <StatTile Label="Other" Source="database Files grouped by MIME, types that map to no kind">@_counts.Other</StatTile>
        }
    </StatGrid>
    <p class="muted">
        Counted the way the Library page lists, so folders you have hidden are left out and the kinds add
        up to <em>Files</em>. The kind comes from the file's type, not from where it sits.
    </p>
</Panel>

@code {
    private const int WorkingSetTargetMb = 200;

    private const long WorkingSetTargetBytes = WorkingSetTargetMb * 1024L * 1024L;

    // The cheap figures - the cache report and the process counters - touch no database, so they tick at
    // this interval. The counts are looked at on the same tick but only re-read when the library changed;
    // see LibraryCountsCache.
    private static readonly TimeSpan _refreshInterval = TimeSpan.FromSeconds(5);

    private static readonly LibraryCountsDto _noCountsYet =
        new() { Total = 0, Video = 0, Audio = 0, Image = 0, Other = 0 };

    private PeriodicTimer? _timer;
    private ServedFileCacheReport _report = null!;
    private LibraryCountsDto _counts = _noCountsYet;
    private DateTimeOffset? _blocked;
    private int _directoryCount;
    private long _workingSetBytes;
    private long _managedBytes;
    private long _lohBytes;
    private int _gen0;
    private int _gen1;
    private int _gen2;
    private TimeSpan _uptime;
    private DateTime _startedUtc;

    protected override async Task OnInitializedAsync()
    {
        ReadCheapFigures();

        await RefreshCountsAsync();

        _timer = new PeriodicTimer(_refreshInterval);

        // Deliberately not awaited: OnInitializedAsync has to return for the page to render at all. The
        // loop ends when PageToken is cancelled, which the base class does on dispose.
        _ = RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(PageToken))
            {
                ReadCheapFigures();

                await RefreshCountsAsync();

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // The operator navigated away, or the circuit went down. Nothing left to refresh.
        }
    }

    /// <remarks>
    /// The shared snapshot first: while the library has not changed and the hidden folders are the same,
    /// nothing here touches the database. The generation is read before counting so a change landing
    /// mid-count is caught on the next tick - see <see cref="LibraryCountsCache.Store"/>.
    /// <para>
    /// The count itself is gated because this page's counts share the circuit's <c>DbContext</c> with
    /// whatever a Maintenance or Preview action is still running, and an ungated read racing a gated write
    /// is the whole failure mode <c>IAdminOperationGate</c> exists for.
    /// </para>
    /// </remarks>
    private async Task RefreshCountsAsync()
    {
        var generation = Changes.Generation;
        var hiddenFolders = string.Join('\n', Visibility.HiddenFromListings);
        var now = Time.GetUtcNow();

        if (CountsCache.Find(generation, hiddenFolders, now) is { } cached)
        {
            _counts = cached.Counts;
            _directoryCount = cached.DirectoryCount;

            return;
        }

        await RunGatedAsync(async cancellationToken =>
        {
            _counts = await Files.CountByKindAsync(cancellationToken);
            _directoryCount = await Directories.CountAsync(cancellationToken);

            CountsCache.Store(new LibraryCountsCache.Snapshot(generation, hiddenFolders, now, _counts, _directoryCount));
        });
    }

    /// <remarks>
    /// Everything here is a counter read: <c>Describe</c> is synchronous and touches no database or disc,
    /// and the rest are process and GC properties. That is what makes a five-second tick affordable.
    /// </remarks>
    private void ReadCheapFigures()
    {
        _report = Cache.Describe();
        _blocked = Blocker.IsBlocked ? Blocker.BlockedUntilUtc : null;

        using var process = System.Diagnostics.Process.GetCurrentProcess();
        var gc = GC.GetGCMemoryInfo();

        // Process.StartTime is local, and subtracting it from a UTC now would report the timezone offset
        // as uptime - which on this machine would read as a server that started two hours in the future.
        _startedUtc = process.StartTime.ToUniversalTime();
        _uptime = DateTime.UtcNow - _startedUtc;

        _workingSetBytes = process.WorkingSet64;
        _managedBytes = GC.GetTotalMemory(forceFullCollection: false);
        _gen0 = GC.CollectionCount(0);
        _gen1 = GC.CollectionCount(1);
        _gen2 = GC.CollectionCount(2);

        // Index 3 is the large object heap, in the fixed order the runtime reports generations.
        _lohBytes = gc.GenerationInfo.Length > 3
            ? gc.GenerationInfo[3].SizeAfterBytes
            : 0;
    }

    /// <remarks>
    /// Base first: it cancels <c>PageToken</c>, so the loop is already unwinding by the time the timer it
    /// is waiting on goes away.
    /// </remarks>
    protected override void Dispose(bool disposing)
    {
        base.Dispose(disposing);

        if (disposing)
        {
            _timer?.Dispose();
        }
    }

    /// <summary>
    /// How often something was served without the disc having to be read.
    /// </summary>
    /// <remarks>
    /// Previews taken from the database count towards this alongside the memory hits: the reason this
    /// figure is on the dashboard at all is acoustic, and a preview read out of SQLite leaves the drives
    /// as untouched as one read out of memory. They are not already in <c>Hits</c> - a payload supplied
    /// from the database misses the memory cache on its way past, so before this it was counted against
    /// the rate rather than for it.
    /// <para>
    /// The denominator stays <c>Hits + Misses</c> for that same reason: the database reads are inside
    /// <c>Misses</c>, so adding them again would count each one twice.
    /// </para>
    /// </remarks>
    private string HitRate()
    {
        var total = _report.Hits + _report.Misses;
        var withoutDisc = _report.Hits + _report.DatabaseHits;

        return total == 0
            ? "nothing served yet"
            : string.Create(CultureInfo.InvariantCulture, $"{withoutDisc * 100.0 / total:0}%");
    }
}
