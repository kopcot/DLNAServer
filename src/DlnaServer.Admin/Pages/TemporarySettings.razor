@page "/admin/settings/temporary"
@rendermode InteractiveServer
@inject ITemporaryFolderVisibility Visibility
@inject ITechnicalTooltips Tooltips
@inject IApiBlocker Blocker
@inject IMediaFormatter Fmt
@inject ILogger<TemporarySettings> Logger

<PageHeader Title="Temporary settings">
    Settings that apply the moment you press the button and are <strong>not</strong> written to your
    settings file. The server forgets them when it restarts.
</PageHeader>

<Panel Heading="Show temporarily hidden folders">
    <p class="muted">
        The folders listed under <em>Temporarily hidden folders</em> on the Settings page are indexed and
        kept up to date, but are not shown and cannot be played. This shows them again for a while.
    </p>

    @if (Visibility.IsVisible)
    {
        <p>They are being shown, until @Fmt.Clock(Visibility.VisibleUntilUtc).</p>

        <div class="actions">
            <button @onclick="Hide">Hide now</button>
        </div>
    }
    else
    {
        <p class="muted">They are hidden.</p>

        <div class="actions">
            <input id="showMinutes" type="number" min="@MinMinutes" max="@MaxMinutes" @bind="_minutes" style="width:80px"
                   aria-label="How many minutes to show the hidden folders for" />
            <span class="muted">minute(s)</span>
            <button class="primary" @onclick="Show">Show now</button>
        </div>
    }
    <Notice Message="@MessageIn(HiddenFoldersArea)" />

    <p class="muted">
        A television already looking at a folder will not notice either way until it browses again &mdash;
        nothing in DLNA tells it the library has changed.
    </p>
</Panel>

<Panel Heading="Show where each value comes from">
    <p class="muted">
        Every figure on these pages is read from somewhere - a setting, a counter, a column. While this is
        on, hovering one shows which. It is off by default because it puts a dotted underline under a
        large part of every page.
    </p>

    @if (Tooltips.IsEnabled)
    {
        <p>They are being shown, until @Fmt.Clock(Tooltips.EnabledUntilUtc).</p>

        <div class="actions">
            <button @onclick="HideTooltips">Hide now</button>
        </div>
    }
    else
    {
        <p class="muted">They are hidden.</p>

        <div class="actions">
            <input id="tooltipMinutes" type="number" min="@MinMinutes" max="@MaxMinutes"
                   aria-label="How many minutes to show where values come from"
                   @bind="_tooltipMinutes" style="width:80px" />
            <span class="muted">minute(s)</span>
            <button class="primary" @onclick="ShowTooltips">Show now</button>
        </div>
    }
    <Notice Message="@MessageIn(TooltipsArea)" />

    <p class="muted">
        A page already open picks this up the next time it draws something. Reload it if nothing changes.
    </p>
</Panel>

@* Here rather than on Maintenance, since 2026-11-10: like the two above it lapses on its own after the
   period chosen and is never written to config.json, so it is the same class of setting. *@
<Panel Heading="Television traffic">
    @if (Blocker.IsBlocked)
    {
        <p>
            Blocked until @Fmt.Clock(Blocker.BlockedUntilUtc).
            <span class="muted">@Blocker.Reason</span>
        </p>
        <div class="actions"><button @onclick="Unblock">Unblock now</button></div>
    }
    else
    {
        <p class="muted">
            Stops answering televisions for a while, so maintenance can run without them reconnecting
            part-way through. These pages keep working throughout.
        </p>
        <div class="actions">
            <input id="blockHours" type="number" min="@MinBlockHours" max="@MaxBlockHours" @bind="_blockHours"
                   style="width:80px" aria-label="How many hours to block televisions for" />
            <span class="muted">hour(s)</span>
            <button @onclick="Block">Block</button>
        </div>
    }
    <Notice Message="@MessageIn(TrafficArea)" />

    <p class="muted">
        While blocked, a television asking the server for anything is told it is unavailable. The server
        still announces itself on the network meanwhile.
    </p>
</Panel>

@code {
    private const int MinMinutes = 1;
    private const int MaxMinutes = 1440;

    /// <summary>
    /// Bounds for the block duration, matching the <c>min</c> and <c>max</c> on the input.
    /// </summary>
    /// <remarks>
    /// The input's own attributes are decoration: there is no <c>EditForm</c> behind it, so they style an
    /// invalid value and submit it anyway. <c>0</c> reached
    /// <c>ArgumentOutOfRangeException.ThrowIfNegativeOrZero</c> inside <c>Block</c> and a large value
    /// overflowed <c>TimeSpan.FromHours</c> - either way the page was lost and the message never set,
    /// so the operator saw a failure with no explanation. Clamped here instead, which is also what the
    /// route constraint on <c>/manage/block/{hours:int:min(1):max(72)}</c> already enforces.
    /// </remarks>
    private const int MinBlockHours = 1;
    private const int MaxBlockHours = 72;
    private const int DefaultBlockHours = 1;

    private int _minutes = 15;
    private int _tooltipMinutes = 15;
    private int _blockHours = DefaultBlockHours;
    private string? _message;

    // Which panel's buttons _message answers, so it is drawn beside them; every message here is an action's.
    private const string HiddenFoldersArea = "hidden";
    private const string TooltipsArea = "tooltips";
    private const string TrafficArea = "traffic";

    private string? _messageArea;

    /// <remarks>
    /// Straight to the singleton, never through <c>ISettingsWriter</c>. That writer serialises the whole
    /// options graph, so a setting held anywhere under <c>DlnaOptions</c> reaches <c>config.json</c> on the
    /// next save - which is the one thing everything on this page must not do.
    /// </remarks>
    private void Show()
    {
        var minutes = Math.Clamp(_minutes, MinMinutes, MaxMinutes);
        _minutes = minutes;

        Visibility.ShowFor(TimeSpan.FromMinutes(minutes));
        Report(HiddenFoldersArea, $"Temporarily hidden folders are showing for {minutes} minute(s).");
    }

    private void Hide()
    {
        Visibility.Hide();
        Report(HiddenFoldersArea, "Temporarily hidden folders are hidden again.");
    }

    private void ShowTooltips()
    {
        var minutes = Math.Clamp(_tooltipMinutes, MinMinutes, MaxMinutes);
        _tooltipMinutes = minutes;

        Tooltips.EnableFor(TimeSpan.FromMinutes(minutes));
        Report(TooltipsArea, $"Values show where they come from for {minutes} minute(s).");
    }

    private void HideTooltips()
    {
        Tooltips.Disable();
        Report(TooltipsArea, "Values no longer show where they come from.");
    }

    private void Block()
    {
        // Clamped, not validated: the input's min/max are decoration without an EditForm behind them.
        var hours = Math.Clamp(_blockHours, MinBlockHours, MaxBlockHours);

        if (hours != _blockHours)
        {
            LogBlockHoursClamped(Logger, _blockHours, hours);
        }

        _blockHours = hours;

        Blocker.Block(TimeSpan.FromHours(hours), $"Paused for {hours} hour(s) from these pages");
        LogTelevisionsBlocked(Logger, hours, Blocker.BlockedUntilUtc);
        Report(TrafficArea, $"Televisions are paused for {hours} hour(s).");
    }

    private void Unblock()
    {
        Blocker.Release();
        LogTelevisionsUnblocked(Logger);
        Report(TrafficArea, "Televisions are being answered again.");
    }

    private void Report(string area, string message)
    {
        _messageArea = area;
        _message = message;
    }

    private string? MessageIn(string area)
    {
        return string.Equals(_messageArea, area, StringComparison.Ordinal)
            ? _message
            : null;
    }
}
