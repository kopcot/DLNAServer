@* A checkbox with its own text, a heading-free field. Eight copies of this markup were hand-written on
   the settings and library pages.

   Its own component rather than a FormField: FormField always emits a <label> heading above its control,
   which is right for an input with a separate caption and wrong here, where the checkbox carries its text
   inside the label it shares. *@

<div class="field">
    <label>
        <input type="checkbox" checked="@Value" @onchange="OnChangedAsync" disabled="@Disabled" />
        @Label
    </label>

    <FieldNotes Hint="Hint" Restart="Restart" />
</div>

@code {
    [Parameter]
    [EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    /// <summary>
    /// What the setting does, in prose.
    /// </summary>
    [Parameter]
    public RenderFragment? Hint { get; set; }

    /// <summary>
    /// A note that the value only takes effect after the server is restarted.
    /// </summary>
    [Parameter]
    public RenderFragment? Restart { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private Task OnChangedAsync(ChangeEventArgs args)
    {
        return ValueChanged.InvokeAsync(args.Value is true);
    }
}
