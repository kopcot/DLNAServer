# Copy to .env and edit. See README.md in this folder.
#
#   cp .env.example .env

# The user the container runs as. It must be able to write into /share/Media, or you get a library with
# no previews and nothing in the log that says why. On the NAS: `id -u` and `id -g`.
PUID=1000
PGID=1000

TZ=Europe/Prague

# Below roughly 512m, thumbnailing a large photo fails rather than being slow.
MEM_LIMIT=1g
