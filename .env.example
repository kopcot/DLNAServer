# Copy to .env and edit. See Docker.usage.md.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------------

# Your media on the HOST. Mounted read-write, because previews are written beside the media.
MEDIA_PATH=/srv/media

# The user the container runs as. It must be able to write into the media tree, or you get a library
# with no previews and nothing in the log that says why. On the host: `id -u` and `id -g`.
PUID=1000
PGID=1000

# ---------------------------------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------------------------------

TZ=Europe/Prague

# Below roughly 512m, thumbnailing a large photo fails rather than being slow - SkiaSharp decodes up to
# 24 million pixels at 4 bytes each.
MEM_LIMIT=1g

# ---------------------------------------------------------------------------------------------------
# Only for docker-compose.admin-remote.yml - exposing the admin pages to the internet
# ---------------------------------------------------------------------------------------------------
# Read the warning at the top of that file first. The admin pages can stop the server and delete the
# index, and the server itself has no authentication - the proxy is the whole of the protection.

# The DNS name the certificate is issued for. The only name that will be answered.
#ADMIN_HOSTNAME=dlna.example.com

#ADMIN_USER=admin

# A bcrypt hash, NOT the password. Cost 10-12, not the tool's default 14: this proxy has no
# brute-force limiting, and cost 14 is roughly a second of NAS CPU per guess - an unauthenticated
# attacker's cheapest lever against the box. Cost 10-12 still costs an attacker real time per guess
# while keeping a real login snappy:
#     docker run --rm caddy:2-alpine caddy hash-password --cost 12 --plaintext 'your-password'
# Double every $ so compose does not read it as a variable.
#ADMIN_PASSWORD_HASH=$$2a$$12$$replace.this.with.the.real.hash

#ADMIN_PORT=26853

# The NAS's own LAN address(es)/hostname - semicolon-separated. AllowedHosts is process-wide, not
# per-port, so setting ADMIN_HOSTNAME above without this also blocks a television reaching the media
# port by LAN IP or hostname with a 400. Leave unset only if nothing ever reaches this box by LAN
# address (unusual - SSDP discovery normally guarantees that it does).
#LAN_HOSTS=192.168.1.50;dlna-nas.local
